generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("postgresql://neondb_owner:npg_Ttfj7NI9HAZc@ep-lively-frost-b3eja2n0-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require")
}

model Employee {
  id        String   @id @default(uuid())
  pin       String   @unique
  name      String
  nip       String?  @default("-")
  role      String   @default("Guru")
  gender    String   @default("L")
  phone     String?  @default("-")
  status    String   @default("Aktif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceLogs AttendanceLog[]
  permissions    Permission[]
}

model AttendanceLog {
  id         String   @id @default(uuid())
  pin        String
  name       String
  date       String   // Format: DD-MM-YYYY
  checkIn    String
  checkOut   String
  status     String
  flagColor  String
  createdAt  DateTime @default(now())

  employee   Employee? @relation(fields: [pin], references: [pin], onDelete: Cascade)
}

model Permission {
  id           String   @id @default(uuid())
  pin          String
  employeeName String
  type         String   // Izin | Sakit | Cuti | Dinas Luar
  startDate    String   // Format: DD-MM-YYYY
  endDate      String   // Format: DD-MM-YYYY
  reason       String
  status       String   @default("Pending") // Pending | Approved | Rejected
  createdAt    DateTime @default(now())

  employee     Employee? @relation(fields: [pin], references: [pin], onDelete: Cascade)
}

model Setting {
  id            String   @id @default("default")
  workStartTime String   @default("07:15") // Jam batas terlambat
  emailNotif    Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}