generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id        String   @id @default(uuid())
  pin       String   @unique
  name      String
  nip       String?  @default("-")
  role      String   @default("Guru")
  gender    String   @default("L")
  phone     String?  @default("-")
  status    String   @default("Aktif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceLogs AttendanceLog[]
  permissions    Permission[]
  schedules      WorkSchedule[]
}

model AttendanceLog {
  id               String   @id @default(uuid())
  pin              String
  name             String
  date             String   // Format Standar: DD-MM-YYYY atau YYYY-MM-DD
  checkIn          String?  // <-- DIUBAH JADI OPTIONAL (agar tidak error jika belum tap)
  checkOut         String?  // <-- DIUBAH JADI OPTIONAL (agar tidak error jika belum tap)
  status           String
  isEarlyLeave     Boolean  @default(false)
  earlyLeaveReason String?
  flagColor        String?  @default("green") // <-- DIUBAH JADI OPTIONAL
  createdAt        DateTime @default(now())

  employee Employee? @relation(fields: [pin], references: [pin], onDelete: Cascade)

  @@index([pin])
  @@index([date])
}

model Permission {
  id             String   @id @default(uuid())
  pin            String
  employeeName   String
  type           String   // Izin | Sakit | Cuti | Dinas Luar | Pulang Awal | Terlambat
  startDate      String   
  endDate        String   
  reason         String
  earlyLeaveTime String?  // Jam rencana pulang (e.g., "12:00")
  status         String   @default("Pending") // Pending | Approved | Rejected
  createdAt      DateTime @default(now())

  employee Employee? @relation(fields: [pin], references: [pin], onDelete: Cascade)

  @@index([pin])
}

model Setting {
  id            String   @id @default("default")
  workStartTime String   @default("07:15") 
  workEndTime   String   @default("14:00") // Batas Jam Pulang Standard
  emailNotif     Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model Holiday {
  id          String   @id @default(cuid())
  date        String   // Format Standar: YYYY-MM-DD
  description String   
  createdAt   DateTime @default(now())

  @@index([date])
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Password terenkripsi (bcrypt)
  name      String
  role      String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkSchedule {
  id         String   @id @default(uuid())
  employeeId String
  dayOfWeek  Int      // 0: Minggu, 1: Senin, 2: Selasa, 3: Rabu, 4: Kamis, 5: Jumat, 6: Sabtu
  isWorking  Boolean  @default(true) // true = Wajib Masuk, false = Libur Mengajar
  startTime  String?  @default("07:15") // Jam Batas Masuk Khusus (misal: "08:00")
  endTime    String?  @default("14:00")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
  @@index([employeeId])
}